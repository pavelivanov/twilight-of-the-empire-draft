# Telegram credentials. Copy this file to .env.railway; the real file is ignored.
# Create the bot and Mini App in @BotFather before deploying.
BOT_TOKEN=
BOT_USERNAME=
TELEGRAM_APP_SHORT_NAME=draft

# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# Optional. Defaults to 86400 seconds (24 hours).
AUTH_MAX_AGE=86400
